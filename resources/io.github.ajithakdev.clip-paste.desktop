[Desktop Entry]
Name=clip-paste
Comment=Auto-pasting clipboard manager applet for COSMIC
Comment[cs]=Applet historie schránky pro COSMIC
Comment[it]=COSMIC applet per la cronologia della clipboard
Comment[pt]=Applet de busca no histórico da área de transferência para COSMIC
Type=Application
Icon=io.github.ajithakdev.clip-paste-symbolic
Exec=cosmic-applet-clip-paste
Terminal=false
StartupNotify=true
Categories=Utility;X-Cosmic;X-Iced;
NoDisplay=true
X-CosmicApplet=true
X-CosmicHoverPopup=Auto
